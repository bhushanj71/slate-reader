# Copy to .env for local development, and set the same names in Render.
# Without a key, Slate falls back to the browser's own voices.

ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2   # the default; flash is cheaper and flatter
# ELEVENLABS_DAILY_LIMIT=150000
# ELEVENLABS_CALLER_LIMIT=30000
